{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "settings":  { ".read": true, ".write": "root.child('admins/' + auth.uid).val() === true" },
    "tools":     { ".read": true, ".write": "root.child('admins/' + auth.uid).val() === true" },
    "plans":     { ".read": true, ".write": "root.child('admins/' + auth.uid).val() === true" },
    "videos":    { ".read": true, ".write": "root.child('admins/' + auth.uid).val() === true" },
    "downloads": { ".read": true, ".write": "root.child('admins/' + auth.uid).val() === true" },
    "assets":    { ".read": true, ".write": "root.child('admins/' + auth.uid).val() === true" },
    "posts":     { ".read": true, ".write": "root.child('admins/' + auth.uid).val() === true" },

    "counts": {
      ".read": true,
      "$id": {
        ".write": "root.child('admins/' + auth.uid).val() === true || (newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1))",
        ".validate": "newData.isNumber()"
      }
    },

    "subscribers": {
      ".read": "root.child('admins/' + auth.uid).val() === true",
      ".write": "root.child('admins/' + auth.uid).val() === true",
      "$id": {
        ".write": "root.child('admins/' + auth.uid).val() === true || !data.exists()",
        ".validate": "newData.hasChildren(['email']) && newData.child('email').isString() && newData.child('email').val().length < 150"
      }
    }
  }
}
